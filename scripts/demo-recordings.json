{
  "program-state": {
    "title": "cvar / ProgramState",
    "launch": "cargo run --quiet --example program-state",
    "startup": "Hit enter to list the properties and actions.\nRead with <name>, assign with <name> <value>, invoke with poke! <text>.\n",
    "steps": [
      {
        "command": "",
        "output": "number is \"42\"\ntext is \"\"\npoke!\n"
      },
      {
        "command": "number 13",
        "output": "number is \"13\"\n"
      },
      {
        "command": "poke! the value is",
        "output": ""
      },
      {
        "command": "text",
        "output": "text is \"the value is: 13\"\n"
      },
      {
        "command": "number nope",
        "output": "error: invalid digit found in string\n"
      },
      {
        "command": "number",
        "output": "number is \"13\"\n"
      }
    ]
  },
  "nesting-techniques": {
    "title": "cvar / scopes and action aliases",
    "launch": "cargo run --quiet --example nesting-techniques",
    "startup": "Hit enter to list all the cvars and their values.\nAssign value to cvar with `<name> <value>`.\n",
    "steps": [
      {
        "command": "foo",
        "output": "foo.bool is \"true\"\nfoo.int\nfoo.int is \"0\"\nfoo.float is \"0\"\nfoo.float\nfoo.string is \"\"\n"
      },
      {
        "command": "foo.bool false",
        "output": "foo.bool is \"false\"\n"
      },
      {
        "command": "foo.int 7",
        "output": "Before int is changed!\nfoo.int is \"7\"\n"
      },
      {
        "command": "foo.string",
        "output": "foo.string is \"0\"\n"
      },
      {
        "command": "foo.float 2.5",
        "output": "foo.float is \"2.5\"\nAfter float has changed!\n"
      },
      {
        "command": "foo.string",
        "output": "foo.string is \"2.5\"\n"
      }
    ]
  },
  "runtime-properties": {
    "title": "cvar / runtime properties",
    "launch": "cargo run --quiet --example runtime-properties",
    "startup": "Hit enter to list all the cvars and their values.\nAssign value to cvar with `<name> <value>`.\nCreate new cvars with `create! <type> <name> <value>`.\nDestroy the cvars with `destroy! <name>`.\n",
    "steps": [
      {
        "command": "create! int player.health 100",
        "output": ""
      },
      {
        "command": "create! float player.speed 4.5",
        "output": ""
      },
      {
        "command": "create! string player.name Ada",
        "output": ""
      },
      {
        "command": "player",
        "output": "player.health is \"100\"\nplayer.speed is \"4.5\"\nplayer.name is \"Ada\"\n"
      },
      {
        "command": "player.health 75",
        "output": "player.health is \"75\"\n"
      },
      {
        "command": "player",
        "output": "player.health is \"75\"\nplayer.speed is \"4.5\"\nplayer.name is \"Ada\"\n"
      },
      {
        "command": "destroy! player.speed",
        "output": ""
      },
      {
        "command": "player",
        "output": "player.health is \"75\"\nplayer.name is \"Ada\"\n"
      },
      {
        "command": "player.speed",
        "output": "error: path \"player.speed\" does not exist\n"
      },
      {
        "command": "destroy! player.health",
        "output": ""
      },
      {
        "command": "destroy! player.name",
        "output": ""
      },
      {
        "command": "player",
        "output": "error: path \"player\" does not exist\n"
      }
    ]
  }
}
